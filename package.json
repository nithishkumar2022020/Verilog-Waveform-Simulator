{
  "name": "verilog-waveform-simulator",
  "displayName": "Verilog Waveform Simulator",
  "description": "Generate and visualize waveforms from Verilog testbenches",
  "version": "0.2.0",
  "publisher": "nithishkumar2022020",
  "repository": {
    "type": "git",
    "url": "https://github.com/nithishkumar2022020/Verilog-Waveform-Simulator"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:verilog",
    "onCommand:verilog-simulator.generateWaveform",
    "onCommand:verilog-simulator.regenerateVcd",
    "onCommand:verilog-simulator.clearCache"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Simulations run Icarus Verilog on project testbenches."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Verilog Waveform Simulator",
      "properties": {
        "verilogSimulator.timeoutSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 3600,
          "description": "Maximum duration for each compilation and simulation phase."
        },
        "verilogSimulator.project": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "includeDirectories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "defines": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "inputFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "top": {
              "type": "string"
            },
            "language": {
              "enum": [
                "2005",
                "2012"
              ]
            },
            "dumpFile": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Assignment settings. Paths are relative to the workspace folder. List HDL source files in compilation order."
        }
      }
    },
    "commands": [
      {
        "command": "verilog-simulator.generateWaveform",
        "title": "Generate Waveform"
      },
      {
        "command": "verilog-simulator.regenerateVcd",
        "title": "Regenerate VCD File"
      },
      {
        "command": "verilog-simulator.clearCache",
        "title": "Clear Environment Cache"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .v || resourceExtname == .sv",
          "command": "verilog-simulator.generateWaveform",
          "group": "verilog"
        },
        {
          "when": "resourceExtname == .v || resourceExtname == .sv",
          "command": "verilog-simulator.regenerateVcd",
          "group": "verilog"
        }
      ]
    },
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh",
          ".sv"
        ]
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint && npm run esbuild-build",
    "test": "node ./test/runTest.js",
    "test:simulation": "mocha --ui tdd test/simulation.test.js",
    "esbuild-base": "esbuild ./extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "esbuild-build": "npm run esbuild-base -- --sourcemap",
    "vscode:prepublish": "npm run esbuild-base -- --minify"
  },
  "dependencies": {
    "plotly.js-dist": "^2.18.2"
  },
  "devDependencies": {
    "@types/glob": "^7.1.4",
    "@types/mocha": "^9.1.1",
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.60.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.15.15",
    "eslint": "^8.14.0",
    "glob": "^7.2.0",
    "mocha": "^9.2.2"
  },
  "keywords": [
    "verilog",
    "waveform",
    "simulation",
    "vcd",
    "visualization"
  ],
  "author": "Nithish Kumar",
  "license": "MIT",
  "icon": "images/icon.png"
}
